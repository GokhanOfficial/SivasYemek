# Docker kullanmadan çalıştırmak için systemd birimi.
# Kurulum:
#   sudo cp -r sivas-yemek /opt/sivas-yemek
#   sudo useradd --system --home /opt/sivas-yemek sivasyemek
#   sudo mkdir -p /var/lib/sivas-yemek && sudo chown sivasyemek /var/lib/sivas-yemek
#   sudo cp deploy/sivas-yemek.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sivas-yemek
#   journalctl -u sivas-yemek -f

[Unit]
Description=Sivas Yemek - yemekhane menuleri
After=network-online.target
Wants=network-online.target

[Service]
User=sivasyemek
WorkingDirectory=/opt/sivas-yemek
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/var/lib/sivas-yemek
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/sivas-yemek/server.py
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sivas-yemek
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
